<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: public API docs are encouraged but not yet enforced.
         CS8524: a switch expression that names every value of an enum is exhaustive. Without a default arm, adding a
         value then fails to compile (CS8509) at every such switch; an undefined value still throws at run time. -->
    <NoWarn>$(NoWarn);CS1591;CS1573;CS8524</NoWarn>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <Product>StrataRec</Product>
    <Description>Columnar recommendation execution engine with multi-layer experiments.</Description>
    <Copyright>Copyright (c) StrataRec contributors</Copyright>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview</VersionSuffix>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <!-- Debug/test builds poison returned buffers to surface use-after-return bugs early (design 4.8). -->
    <DefineConstants>$(DefineConstants);STRATAREC_POISON_BUFFERS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <IsProductionCode Condition="$(MSBuildProjectDirectory.Contains('/src/')) Or $(MSBuildProjectDirectory.Contains('\src\'))">true</IsProductionCode>
  </PropertyGroup>

  <!--
    Production code (src/) must not use LINQ: it allocates enumerators, closures and intermediate collections on
    paths that scale with candidate count. Enforced by RS0030 (BannedSymbols.txt) and by not importing System.Linq.
    Tests and benchmarks are exempt.
  -->
  <PropertyGroup Condition="'$(IsProductionCode)' == 'true'">
    <IsPackable>true</IsPackable>
    <WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsProductionCode)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>
</Project>
