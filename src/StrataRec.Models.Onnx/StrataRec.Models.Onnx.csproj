<Project Sdk="Microsoft.NET.Sdk">

  <!-- The one project with a native dependency (ONNX Runtime): hosts that serve ONNX models reference it; the engine's
       own packages stay free of native code. -->
  <PropertyGroup>
    <RootNamespace>StrataRec.Models.Onnx</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StrataRec.Models\StrataRec.Models.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StrataRec.UnitTests" />
    <InternalsVisibleTo Include="StrataRec.IntegrationTests" />
    <InternalsVisibleTo Include="StrataRec.Benchmarks" />
  </ItemGroup>

</Project>
