<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>StrataRec.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Numerics.Tensors" />
    <PackageReference Include="System.IO.Hashing" />
    <!-- Observability (design 13.1, 13.2): the StrataRec Meter and ActivitySource, and ILogger for event logs. -->
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StrataRec.UnitTests" />
    <InternalsVisibleTo Include="StrataRec.IntegrationTests" />
    <InternalsVisibleTo Include="StrataRec.Benchmarks" />
  </ItemGroup>

</Project>
