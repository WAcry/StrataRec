<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>StrataRec.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Numerics.Tensors" />
    <PackageReference Include="System.IO.Hashing" />
    <!-- Observability (design 13.1, 13.2): ILogger for event logs; the Meter and ActivitySource are in the framework. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one I/O boundary (Threading/BoundedCall.cs) is the engine's own: feature fetches and service calls use it,
         hosts and operators reach it only through OperatorContext.CallAsync. -->
    <InternalsVisibleTo Include="StrataRec.Features" />
    <InternalsVisibleTo Include="StrataRec.Pipeline" />
    <InternalsVisibleTo Include="StrataRec.Hosting" />
    <InternalsVisibleTo Include="StrataRec.UnitTests" />
    <InternalsVisibleTo Include="StrataRec.IntegrationTests" />
    <InternalsVisibleTo Include="StrataRec.Benchmarks" />
  </ItemGroup>

</Project>
