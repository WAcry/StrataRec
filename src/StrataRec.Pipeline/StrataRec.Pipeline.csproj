<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>StrataRec.Pipeline</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StrataRec.Core\StrataRec.Core.csproj" />
    <ProjectReference Include="..\StrataRec.Expressions\StrataRec.Expressions.csproj" />
    <ProjectReference Include="..\StrataRec.Features\StrataRec.Features.csproj" />
    <ProjectReference Include="..\StrataRec.Models\StrataRec.Models.csproj" />
    <ProjectReference Include="..\StrataRec.Logging\StrataRec.Logging.csproj" />
    <ProjectReference Include="..\StrataRec.Artifacts\StrataRec.Artifacts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- The experiment compiler assigns a plan's trigger sites (TimelineSlot.SiteExperiments, ParamExperiments) before the
         plan is built; those setters are internal so a plan cannot be changed once it is shared. -->
    <InternalsVisibleTo Include="StrataRec.Experiments" />
    <!-- The executor layer (PipelineExecutor, PipelineRequest, PipelineResult, RunReplay, ReplayJson) is internal: hosts
         run pipelines through RecEngine, the one host API, and tests reach the executor directly. -->
    <InternalsVisibleTo Include="StrataRec.Hosting" />
    <InternalsVisibleTo Include="StrataRec.UnitTests" />
    <InternalsVisibleTo Include="StrataRec.IntegrationTests" />
    <InternalsVisibleTo Include="StrataRec.Benchmarks" />
  </ItemGroup>

</Project>
