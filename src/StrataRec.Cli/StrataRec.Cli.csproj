<Project Sdk="Microsoft.NET.Sdk">

  <!-- The stratarec tool: the commands of StrataRec.CommandLine with what this tool ships (Program.CreateEnvironment). -->
  <PropertyGroup>
    <RootNamespace>StrataRec.Cli</RootNamespace>
    <OutputType>Exe</OutputType>
    <AssemblyName>stratarec</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>stratarec</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StrataRec.CommandLine\StrataRec.CommandLine.csproj" />
    <ProjectReference Include="..\StrataRec.Redis\StrataRec.Redis.csproj" />
    <ProjectReference Include="..\StrataRec.Llm\StrataRec.Llm.csproj" />
  </ItemGroup>

</Project>
