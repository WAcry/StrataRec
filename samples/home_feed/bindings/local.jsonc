// Local bindings: every source reads fixtures in this workspace, so the pipeline runs offline and deterministically.
{
  "environment": "local",
  "sources": {
    // In-memory fixtures answer synchronously in microseconds. The timeout only bounds a cold start (JIT) on a busy
    // machine: an answer the fetch sees after its bound is a timeout, however it arrived (design 4.8).
    "user_store":   { "connector": "memory@1", "data_file": "fixtures/users.json", "timeout_ms": 1000 },
    "item_store":   { "connector": "memory@1", "data_file": "fixtures/items.json", "timeout_ms": 1000, "max_batch": 25 },
    // Creators are a bounded set read for every request: an in-process table (design 6.6) loaded from a snapshot
    // directory, with no I/O on the request path. The engine serves the plan once the first load is complete.
    "author_store": {
      "mode": "local",
      "max_bytes": "16MiB",
      "bootstrap": { "source": "snapshot_files@1", "uri": "fixtures/author_snapshot" }
    }
  },
  "models": {
    "ctr_model": {
      "client": "linear@1",
      "outputs": { "p_click": { "bias": -1.5, "weights": { "smoothed_ctr": 12.0, "log_followers": 0.05 }, "activation": "sigmoid" } }
    }
  },
  "candidate_sources": {
    "two_tower": { "client": "memory_list@1", "data_file": "fixtures/recall_two_tower.json" },
    "popular":   { "client": "memory_list@1", "data_file": "fixtures/recall_popular.json" }
  }
}
