// Local bindings: every source reads fixtures in this workspace, so the pipeline runs offline and deterministically.
{
  "$schema": "../schemas/bindings.schema.json",
  "environment": "local",
  "sources": {
    // In-memory fixtures answer synchronously in microseconds. The timeout only bounds a cold start (JIT) on a busy
    // machine: an answer the fetch sees after its bound is a timeout, however it arrived (design 4.8).
    "user_store":   { "connector": "memory@1", "data_file": "fixtures/users.json", "timeout_ms": 1000 },
    "item_store":   { "connector": "memory@1", "data_file": "fixtures/items.json", "timeout_ms": 1000, "max_batch": 25 },
    // Creators are a bounded set read for every request: an in-process table (design 6.6) loaded from a snapshot
    // directory, with no I/O on the request path. The engine serves the plan once the first load is complete.
    "author_store": {
      "mode": "local",
      "max_bytes": "16MiB",
      "bootstrap": { "source": "snapshot_files@1", "uri": "fixtures/author_snapshot" }
    },
    // A country's region, and each region's weight, keyed by the region geo_store answered (a chain of context keys).
    "geo_store":    { "connector": "memory@1", "data": { "US": { "region": "na" }, "CA": { "region": "na" }, "DE": { "region": "eu" } }, "timeout_ms": 1000 },
    "region_store": { "connector": "memory@1", "data": { "na": { "boost": 1.1 }, "eu": { "boost": 0.9 } }, "timeout_ms": 1000 },
    // Per-country boosts of items, keyed by [item, country]: a snapshot line's key is the array of both parts.
    "item_country_store": {
      "mode": "local",
      "max_bytes": "4MiB",
      "bootstrap": { "source": "snapshot_files@1", "uri": "fixtures/item_country_snapshot" }
    },
    // The features of the engagement entity, which has args: the service below computes them.
    "engagement_model": { "mode": "service", "service": "engagement_model", "timeout_ms": 1000 }
  },
  "services": {
    "ctr_model": {
      "client": "linear@1",
      "outputs": { "p_click": { "bias": -1.5, "weights": { "smoothed_ctr": 12.0, "log_followers": 0.05 }, "activation": "sigmoid" } }
    },
    // The two-tower service's stand-in: an in-memory index scored by the dot product with the query's user_embedding
    // (the recall node's queries). Items below min_score are not returned.
    "two_tower": { "client": "memory_vectors@1", "data_file": "fixtures/recall_vectors.json", "query": "user_embedding", "min_score": 0.01 },
    "popular":   { "client": "memory_list@1", "data_file": "fixtures/recall_popular.json" },
    // A user's propensity to engage, from the arguments of the engagement entity. A "cache" here would share its answers
    // between requests with the same arguments.
    "engagement_model": {
      "client": "linear@1",
      "outputs": { "propensity": { "bias": -1.0, "weights": { "ctr": 20.0 }, "activation": "sigmoid" } }
    }
  }
}
